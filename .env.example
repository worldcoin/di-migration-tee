# Use `local` for human-readable stdout logs or `datadog` for trace-correlated JSON logs and spans.
TELEMETRY_PRESET=local
TELEMETRY_SERVICE_NAME=di-dev-host

# The enclave to relay migrations to. Both are required; the host refuses to start without them.
ENCLAVE_CID=16
ENCLAVE_PORT=1000

# Optional. Compressed request body and decompressed PCP ceilings, in bytes. The defaults are
# 16 MiB and 64 MiB; the decompressed one must not exceed what the enclave accepts.
# MAX_REQUEST_BYTES=16777216
# MAX_PCP_BYTES=67108864

# Optional. Defaults to 8000.
# PORT=8000
